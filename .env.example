# Copy to .env (or let `make setup` / scripts/bootstrap-vps.sh do it for you).

# Domain whose A record points at this server. Used for the nginx vhost and
# the Let's Encrypt certificate.
DOMAIN=gym.example.com

# Where Let's Encrypt sends certificate-expiry warnings.
LETSENCRYPT_EMAIL=admin@example.com

# Loopback-only port this project's container publishes, which the host nginx
# proxies to. MUST be unique per project on a shared VPS — bootstrap-vps.sh
# picks a free one automatically.
APP_HTTP_PORT=8091

# Set to true to use Let's Encrypt's staging environment (certificates are not
# trusted by browsers, but the rate limits are far looser — useful while
# testing the deployment).
LETSENCRYPT_STAGING=false

# Admin password seeded the first time the database is created. Leave empty to
# get the built-in default ("Nosrati1405!"), which you should then change from
# the admin settings panel. `make setup` generates a random one.
ADMIN_INITIAL_PASSWORD=

# Image tag, if you want to pin a specific build instead of :latest.
IMAGE_TAG=latest
